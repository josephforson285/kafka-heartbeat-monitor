  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Fleet \u2014 all patients, ignores the patient selector",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Patients reporting",
      "description": "Patients that have sent a reading in the last 60 seconds \u2014 who is being monitored right now. It used to count anyone seen anywhere in the time range, so a dead producer read 50 for a full window before decaying. Paired with 'Patients gone silent' it now tells one story: reporting falls as silent rises.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT customer_id) AS value FROM heartbeat_readings WHERE event_time > now() - interval '60 seconds'"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Patients gone silent",
      "description": "Patients that reported earlier in the window but have sent nothing for 60 seconds. Without this, a sensor or producer failing looks identical to a healthy patient: the readings simply stop and every other panel keeps showing the last good data. For a monitor, absence of data is the failure that matters most, and nothing else on this dashboard detects it. Normal gaps between a patient's readings are 1.5s on average and 5.4s at the 99th percentile, so 60s is roughly eleven times the worst ordinary pause. How many go silent tells you what broke: one or two is that patient's device or link, all fifty at once is the producer, Kafka or the consumer, because fifty devices do not fail in the same second.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM ( SELECT customer_id FROM heartbeat_readings WHERE $__timeFilter(event_time) GROUP BY 1 HAVING max(event_time) < now() - interval '60 seconds') p"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical readings",
      "description": "Readings above the critical threshold in this window. Counted as readings, not patients: this generator spreads anomalies evenly across the fleet, so a patient count would read 50 of 50 and tell you nothing. Real distress concentrates in a few people, and there a patient count would be the right measure.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time) AND hr_class = 'critical'"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingest latency p95",
      "description": "Producer clock to durable row. How far behind reality the dashboard is.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 13,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM ingested_at - event_time)) * 1000 AS value FROM heartbeat_readings WHERE $__timeFilter(event_time)"
        }
      ]
    },
    {
