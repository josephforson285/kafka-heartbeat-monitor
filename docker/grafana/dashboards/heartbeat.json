{
  "uid": "heartbeat-overview",
  "title": "Heart Beat Monitoring",
  "tags": [
    "heartbeat",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "customer",
        "label": "Customer",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "heartbeat-pg"
        },
        "query": "SELECT DISTINCT customer_id FROM heartbeat_readings ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Readings stored",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerting readings",
      "description": "Readings outside the normal band. Real data, not sensor faults.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time) AND hr_class <> 'normal'"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rejected messages",
      "description": "Failed the contract or were physically impossible. Kept, not discarded.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM heartbeat_rejects WHERE $__timeFilter(rejected_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ingest latency (p95)",
      "description": "ingested_at - event_time: producer clock to durable row.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM ingested_at - event_time)) * 1000 AS value FROM heartbeat_readings WHERE $__timeFilter(event_time)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heart rate range by customer",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bpm",
          "min": 30,
          "max": 220,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "gradientMode": "scheme"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 60
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(event_time, $__interval), customer_id || ' peak' AS metric, max(heart_rate) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time) AND customer_id IN ($customer) GROUP BY 1, 2 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(event_time, $__interval), customer_id || ' low' AS metric, min(heart_rate) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time) AND customer_id IN ($customer) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "description": "Highest and lowest reading in each interval, not the average. Averaging hides both ends: in one minute of this data the readings span 20 to 250 bpm while the mean sits at 73, so a patient at 250 would be drawn as normal."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Patients currently outside the normal band",
      "description": "Latest reading per customer, abnormal ones only.",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hr_class"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "tachycardia": {
                        "color": "orange",
                        "index": 1
                      },
                      "bradycardia": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "event_time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT * FROM (SELECT DISTINCT ON (customer_id) customer_id, heart_rate, hr_class, event_time FROM heartbeat_readings WHERE $__timeFilter(event_time) ORDER BY customer_id, event_time DESC) latest WHERE hr_class <> 'normal' ORDER BY event_time DESC"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Readings by classification",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "normal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bradycardia"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tachycardia"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(event_time, $__interval), hr_class AS metric, count(*) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Why messages were rejected",
      "description": "Why each message failed, and where in the log it came from.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT rejected_at, reason, kafka_partition, kafka_offset FROM heartbeat_rejects WHERE $__timeFilter(rejected_at) ORDER BY rejected_at DESC LIMIT 50"
        }
      ]
    }
  ]
}
