{
  "uid": "heartbeat-overview",
  "title": "Heart Beat Monitoring",
  "tags": [
    "heartbeat",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "customer",
        "label": "Patient",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "heartbeat-pg"
        },
        "query": "SELECT DISTINCT customer_id FROM heartbeat_readings ORDER BY 1",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {
          "text": "cust-0001",
          "value": "cust-0001"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Fleet \u2014 all patients, ignores the patient selector",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Patients reporting",
      "description": "Patients that have sent a reading in the last 60 seconds.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT customer_id) AS value FROM heartbeat_readings WHERE event_time > now() - interval '60 seconds'"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Patients gone silent",
      "description": "Patients that reported earlier but have sent nothing for 60 seconds. One or two points at that device; all of them points at the pipeline.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM ( SELECT customer_id FROM heartbeat_readings WHERE $__timeFilter(event_time) GROUP BY 1 HAVING max(event_time) < now() - interval '60 seconds') p"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical readings / min",
      "description": "Readings above 180 bpm in the last minute. Amber above 66, red at 120 where the alert fires. Baseline is about 37 a minute.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 66
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM heartbeat_readings WHERE event_time > now() - interval '1 minute' AND hr_class = 'critical'"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingest latency p95",
      "description": "Producer clock to durable row. How far behind reality the dashboard is.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 13,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM ingested_at - event_time)) * 1000 AS value FROM heartbeat_readings WHERE $__timeFilter(event_time)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Messages rejected",
      "description": "Failed the contract or were impossible. Kept in heartbeat_rejects, never silently dropped.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM heartbeat_rejects WHERE $__timeFilter(rejected_at)"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Selected patient \u2014 $customer",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "$customer \u2014 every reading",
      "description": "Actual readings in order, not an aggregate. One patient produces roughly one reading a second, so nothing is averaged away.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bpm",
          "min": 0,
          "max": 260,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "gradientMode": "scheme",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 60
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT event_time AS time, heart_rate AS \"bpm\" FROM heartbeat_readings WHERE $__timeFilter(event_time) AND customer_id = '$customer' ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "$customer \u2014 in this window",
      "description": "Summary for the selected patient only.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "highest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bpm"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 100
                    },
                    {
                      "color": "red",
                      "value": 180
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lowest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bpm"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "abnormal readings"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "average"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bpm"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 60
                    },
                    {
                      "color": "orange",
                      "value": 100
                    },
                    {
                      "color": "red",
                      "value": 180
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT max(heart_rate) AS \"highest\", min(heart_rate) AS \"lowest\", round(avg(heart_rate)) AS \"average\", count(*) AS \"readings\", count(*) FILTER (WHERE hr_class <> 'normal') AS \"abnormal readings\" FROM heartbeat_readings WHERE $__timeFilter(event_time) AND customer_id = '$customer'"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Who needs attention",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Patients gone silent \u2014 longest first",
      "description": "Which patients the silence count refers to, and how long each has been quiet. Empty while the fleet is healthy.",
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "silent_for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT customer_id AS patient, max(event_time) AS last_seen, round(extract(epoch FROM now() - max(event_time))) AS silent_for FROM heartbeat_readings WHERE $__timeFilter(event_time) GROUP BY 1 HAVING max(event_time) < now() - interval '60 seconds' ORDER BY max(event_time) ASC"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Patients ranked by episodes in this window",
      "description": "Counts across the whole window, not the latest reading. Bradycardia is not ranked here because it tracks resting baseline rather than deterioration.",
      "gridPos": {
        "h": 10,
        "w": 11,
        "x": 6,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical readings"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "peak"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bpm"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT customer_id AS patient, count(*) FILTER (WHERE hr_class='critical') AS \"critical readings\", count(*) FILTER (WHERE hr_class='tachycardia') AS \"tachycardia readings\", max(heart_rate) AS \"peak\", max(event_time) FILTER (WHERE hr_class IN ('critical','tachycardia')) AS \"last episode\" FROM heartbeat_readings WHERE $__timeFilter(event_time) GROUP BY 1 HAVING count(*) FILTER (WHERE hr_class IN ('critical','tachycardia')) > 0 ORDER BY 2 DESC, 3 DESC, 4 DESC"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fleet readings by classification",
      "description": "Every patient. How the whole population is distributed over time \u2014 not the selected patient.",
      "gridPos": {
        "h": 10,
        "w": 7,
        "x": 17,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "normal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bradycardia"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tachycardia"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(event_time, $__interval), hr_class AS metric, count(*) AS value FROM heartbeat_readings WHERE $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Pipeline health \u2014 all patients",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Why messages were rejected",
      "description": "Every rejection with its reason and the exact partition and offset it came from.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT rejected_at, reason, kafka_partition, kafka_offset FROM heartbeat_rejects WHERE $__timeFilter(rejected_at) ORDER BY rejected_at DESC LIMIT 50"
        }
      ]
    }
  ]
}
